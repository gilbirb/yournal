SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# From Google AI Studio. Without it, AI search falls back to keyword search.
GEMINI_API_KEY=

# UUID of the shared demo account (the one on the login screen). It gets its
# own daily AI limit, shared by everyone who signs in with it.
DEMO_USER_ID=

PORT=3000
CORS_ORIGIN=http://localhost:5173

# Optional, local only. Requests with no token act as this user.
# Never set this in production.
# DEV_USER_ID=
