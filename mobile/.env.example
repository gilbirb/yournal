# Copy to .env and fill in. EXPO_PUBLIC_ vars are inlined into the JS bundle at
# build time, so treat them as public -- never put the service_role key here.

# NOT localhost. The device/emulator resolves localhost to itself, not your Mac.
#   iOS Simulator .......... http://localhost:3000   (shares the host network)
#   Android emulator ....... http://10.0.2.2:3000    (host alias)
#   Physical device ........ http://<your-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Same two values as web/.env -- the anon key is safe to ship, the schema keeps
# entries behind the Express server rather than direct table access.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
